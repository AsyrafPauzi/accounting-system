APP_NAME=BukuCloud
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# Production (ECS/ALB): use your public HTTPS URL, e.g. https://app.bukucloud.com
# FORCE_HTTPS=true

# Optional. When set, platform-level admin pages (license manager, patch
# broadcaster, tenant management) are only reachable on this exact host.
# Production: INTERNAL_ADMIN_HOST=internal.bukucloud.com
# Local dev: leave unset so /admin/* keeps working on 127.0.0.1.
# INTERNAL_ADMIN_HOST=internal.bukucloud.com

# Current running version of this install. Self-hosted instances compare
# this to the version advertised by the publisher's heartbeat response;
# when they don't match, the in-app "update available" banner appears.
APP_VERSION=1.0.0

# Visible product name in the app shell (sidebar, titles). Defaults to BukuCloud if unset.
# APP_PRODUCT_NAME=MyBrand
# Optional subtitle under the product name in the sidebar (leave unset or empty to hide).
# APP_PRODUCT_TAGLINE=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
# Encrypts session payloads at rest in the sessions table. Cheap to enable
# and protects against DB snapshot leaks. Local dev can leave this off if
# you want to inspect raw session contents while debugging.
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Production MUST set SESSION_SECURE_COOKIE=true so the session cookie is
# only sent over HTTPS. Local HTTP development must leave it false (the
# browser silently drops "secure" cookies on http://, breaking CSRF).
SESSION_SECURE_COOKIE=false
# Browser SameSite policy. "lax" is the modern default — sends the cookie
# on top-level navigation but blocks third-party POSTs (CSRF defence).
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Tenant uploads: bill receipts and similar files on the public disk (not invoice PDFs).
# local = storage/tenant*/app/public/ — on ECS mount EFS on /var/www/html/storage
# s3    = private objects in AWS_BUCKET (recommended for production)
FILESYSTEM_PUBLIC_DRIVER=local
QUEUE_CONNECTION=sync

CACHE_STORE=database
# With Stancl tenancy, the app default DB is the tenant; cache/session/queue tables live on central.
# Defaults fall back to DB_CONNECTION — set explicitly if you use a named central connection:
# DB_CACHE_CONNECTION=mysql
# SESSION_CONNECTION=mysql
# DB_QUEUE_CONNECTION=mysql
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=resend
MAIL_FROM_ADDRESS="no-reply@app.bukucloud.com"
MAIL_FROM_NAME="BukuCloud"
# Optional. Absolute URL to the logo rendered in the mail header. Defaults
# to {APP_URL}/images/bukucloud-logo.png. Set this when APP_URL is not
# publicly reachable (e.g. local dev sending real Resend emails to Gmail/
# Outlook — point this at https://app.bukucloud.com/images/bukucloud-logo.png).
# MAIL_LOGO_URL=https://app.bukucloud.com/images/bukucloud-logo.png

RESEND_API_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Invoice PDF Company (Seller) Details (optional; uses APP_NAME if not set)
# INVOICE_COMPANY_NAME="${APP_NAME}"
# INVOICE_COMPANY_ADDRESS=123 Business Street
# INVOICE_COMPANY_CITY=Kuala Lumpur
# INVOICE_COMPANY_STATE=Wilayah Persekutuan
# INVOICE_COMPANY_ZIP=50000
# INVOICE_COMPANY_COUNTRY=Malaysia
# INVOICE_COMPANY_PHONE=
# INVOICE_COMPANY_EMAIL=
# INVOICE_COMPANY_WEBSITE=
# INVOICE_COMPANY_TIN=
# INVOICE_COMPANY_BRN=

# Invoice Email Behaviour (optional; sensible defaults provided)
# INVOICE_EMAIL_SUBJECT="Invoice :number from :company"
# INVOICE_EMAIL_INTRO="Please find attached your tax invoice in PDF format."
# INVOICE_EMAIL_FOOTER="Thank you for your business."

# ToyyibPay Configuration
TOYYIBPAY_SECRET_KEY=
TOYYIBPAY_CATEGORY_CODE=
TOYYIBPAY_ENV=sandbox # sandbox or production

# ─────────────────────────────────────────────────────────────────────
# OAuth-style API integration ("Connect to BukuCloud" partners)
# ─────────────────────────────────────────────────────────────────────
# Each partner gets a slug, a secret, and one or more redirect URIs.
# Today only Fin Persona is registered (config/oauth.php). Generate
# the secret as a long random string (e.g. `php artisan key:generate
# --show`) and share with the partner over a secure channel.
#
# FINPERSONA_CLIENT_SECRET=base64:...64chars...
# FINPERSONA_REDIRECT_URI=https://app.finpersona.com/integrations/bukucloud/callback
# FINPERSONA_REDIRECT_URI_DEV=http://localhost:3000/integrations/bukucloud/callback
#
# Reject signed requests whose timestamp is more than this many seconds
# off server time (replay-attack window). Default 300s = 5 minutes.
# OAUTH_SIGNATURE_SKEW=300
