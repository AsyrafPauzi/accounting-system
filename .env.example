APP_NAME=BukuCloud
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# Production (ECS/ALB): use your public HTTPS URL, e.g. https://app.bukucloud.com
# FORCE_HTTPS=true

# Visible product name in the app shell (sidebar, titles). Defaults to BukuCloud if unset.
# APP_PRODUCT_NAME=MyBrand
# Optional subtitle under the product name in the sidebar (leave unset or empty to hide).
# APP_PRODUCT_TAGLINE=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# SESSION_SECURE_COOKIE=true enforces HTTPS. Set to false for local HTTP development 
# to avoid "CSRF Token Mismatch" errors caused by the browser blocking non-HTTPS cookies.
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database
# With Stancl tenancy, the app default DB is the tenant; cache/session/queue tables live on central.
# Defaults fall back to DB_CONNECTION — set explicitly if you use a named central connection:
# DB_CACHE_CONNECTION=mysql
# SESSION_CONNECTION=mysql
# DB_QUEUE_CONNECTION=mysql
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=mailgun
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

MAILGUN_DOMAIN=
MAILGUN_SECRET=
MAILGUN_ENDPOINT=api.mailgun.net

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Invoice PDF Company (Seller) Details (optional; uses APP_NAME if not set)
# INVOICE_COMPANY_NAME="${APP_NAME}"
# INVOICE_COMPANY_ADDRESS=123 Business Street
# INVOICE_COMPANY_CITY=Kuala Lumpur
# INVOICE_COMPANY_STATE=Wilayah Persekutuan
# INVOICE_COMPANY_ZIP=50000
# INVOICE_COMPANY_COUNTRY=Malaysia
# INVOICE_COMPANY_PHONE=
# INVOICE_COMPANY_EMAIL=
# INVOICE_COMPANY_WEBSITE=
# INVOICE_COMPANY_TIN=
# INVOICE_COMPANY_BRN=

# Invoice Email Behaviour (optional; sensible defaults provided)
# INVOICE_EMAIL_SUBJECT="Invoice :number from :company"
# INVOICE_EMAIL_INTRO="Please find attached your tax invoice in PDF format."
# INVOICE_EMAIL_FOOTER="Thank you for your business."

# ToyyibPay Configuration
TOYYIBPAY_SECRET_KEY=
TOYYIBPAY_CATEGORY_CODE=
TOYYIBPAY_ENV=sandbox # sandbox or production
