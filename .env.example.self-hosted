# BukuCloud self-hosted environment template.
#
# Copy to .env, fill in the values that need filling, then run
#   docker compose up -d
#
# Lines marked "REQUIRED" must be set before first boot — the install
# wizard at http://localhost:8000/install will refuse to proceed
# without them. Lines marked "OPTIONAL" can be left as-is for most
# small deployments.

# ─────────────────────────────────────────────────────────────────────
# Application
# ─────────────────────────────────────────────────────────────────────

# REQUIRED — flips the runtime into self-hosted mode. Don't change
# this unless you really know why.
APP_DEPLOYMENT_MODE=self_hosted

# REQUIRED — the URL your users will type into their browser.
APP_URL=http://localhost:8000

# REQUIRED — generated with `php artisan key:generate`.
APP_KEY=

APP_NAME=BukuCloud
APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=Asia/Kuala_Lumpur
APP_LOCALE=en

# Optional — pin the version of the BukuCloud Docker image. Defaults
# to "latest" which always pulls the newest stable on `docker compose pull`.
BUKUCLOUD_VERSION=latest

# Port the nginx container exposes on the host.
BUKUCLOUD_HTTP_PORT=8000

# ─────────────────────────────────────────────────────────────────────
# Licence
# ─────────────────────────────────────────────────────────────────────
# REQUIRED — the licence key emailed to you on purchase. You can also
# leave this blank and paste it into the install wizard on first boot.
APP_LICENSE_KEY=

# REQUIRED — the BukuCloud public key (PEM). The release archive ships
# with this pre-filled; only edit if support gives you a new one.
# Use literal \n between PEM lines (vlucas/phpdotenv decodes them inside double quotes).
APP_LICENSE_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEAqctgJkprrFEoDhpQM554\n5ozkIEFQYzCOrAFy9ngh3MFT1Wi/CS2EtclaErsawF1h+9E0yPxxBTnlHcuyIaND\nMcIn0coHgNduKqafAQ6rIVt81q6LFO2spldTajJvc+loVFYRikFPUZiecyk5+EUK\nVj9whNmnAA0ZK5HOs/kcbYacZRPLAeMSXqZgWGkH57Y01ICIO2ysB4hCeW8AiZ0G\nT4KzQccIYI3t1rUxBO7b3i2+66FjQylV+kzgNs7K+LmYKFe7lQ65alWkr3GbrfyO\nZNDgJmui1LvWg2bNehOYSGigQUw16znESb7XmKKil753iV10nW44Bi00Q4PtXxku\nSwIDAQAB\n-----END PUBLIC KEY-----"

# OPTIONAL — heartbeat endpoint + grace period. Defaults below match
# the production publisher; only change if running an air-gapped
# install, in which case you should also disable the heartbeat
# scheduler entry in routes/console.php.
APP_HEARTBEAT_ENDPOINT=https://api.bukucloud.io/api/self-hosted/heartbeat
APP_HEARTBEAT_GRACE_DAYS=14

# Current running version of this install. The daily heartbeat sends
# this to the publisher and compares against the publisher's
# "latest_release_version" — when they differ, the in-app "update
# available" banner is shown. Bump on every Docker image release.
APP_VERSION=1.0.0

# ─────────────────────────────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=bukucloud
DB_USERNAME=bukucloud

# REQUIRED — pick a strong password.
DB_PASSWORD=please-change-me
DB_ROOT_PASSWORD=please-change-me-too

# ─────────────────────────────────────────────────────────────────────
# Cache, queue, sessions
# ─────────────────────────────────────────────────────────────────────
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
REDIS_HOST=redis
REDIS_PORT=6379

# ─────────────────────────────────────────────────────────────────────
# File storage
# ─────────────────────────────────────────────────────────────────────
# Self-hosted defaults to local disk inside the `app_storage` volume.
# Switch to s3 / spaces / minio if you have an object store.
FILESYSTEM_DISK=local

# ─────────────────────────────────────────────────────────────────────
# Mail (optional)
# ─────────────────────────────────────────────────────────────────────
MAIL_MAILER=log
MAIL_FROM_ADDRESS=no-reply@example.test
MAIL_FROM_NAME="BukuCloud"

# ─────────────────────────────────────────────────────────────────────
# Vendor / renewal contact
# ─────────────────────────────────────────────────────────────────────
# Surfaced on the in-app "License & Usage" page so customers know who
# to contact for renewal, seat expansion, or support. Resellers / SI
# partners override these with their own brand details.
SELFHOSTED_VENDOR_NAME="BukuCloud"
# SELFHOSTED_VENDOR_EMAIL=billing@bukucloud.com
# SELFHOSTED_VENDOR_URL=https://bukucloud.com/billing

# ─────────────────────────────────────────────────────────────────────
# OCR (optional)
# ─────────────────────────────────────────────────────────────────────
# Leave these blank to disable OCR. Setting GEMINI_API_KEY enables
# Google Gemini-based receipt parsing.
GEMINI_API_KEY=
TESSERACT_BIN=/usr/bin/tesseract
