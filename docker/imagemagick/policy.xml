<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policymap [
  <!ELEMENT policymap (policy)+>
  <!ATTLIST policymap xmlns CDATA #FIXED ''>
  <!ELEMENT policy EMPTY>
  <!ATTLIST policy xmlns CDATA #FIXED '' domain NMTOKEN #REQUIRED
    name NMTOKEN #IMPLIED pattern CDATA #IMPLIED rights NMTOKEN #IMPLIED
    stealth NMTOKEN #IMPLIED value CDATA #IMPLIED>
]>
<!--
  ImageMagick policy for the BukuCloud OCR pipeline.

  We invoke `magick` ONLY through App\Services\Ocr\ImagePreprocessor and only
  on user-uploaded JPG / PNG / WEBP receipts (PDFs are converted to PNG by
  poppler's pdftoppm BEFORE they hit ImageMagick). So we lock the policy down
  hard:

    * no PDF coder        — closes the long history of Ghostscript-via-PS bugs
    * no MSL / MVG        — server-side magick scripting we never use
    * no EPS / PS / XPS   — same reason; not needed
    * no LABEL / TEXT     — kills CVE-2016-3717 (filename-as-template)
    * no URL / ephemeral  — no remote fetches, no source-file deletion
    * no SHOW / WIN       — interactive coders make no sense in a server
    * resource caps       — bound a single magick run so a malicious upload
                            can't OOM the container

  Anything not in the deny-list (PNG, JPEG, WEBP, GIF, plus our actual
  output coder PNG) keeps working, which is exactly what ImagePreprocessor
  needs.
-->
<policymap>
  <!-- Resource ceilings. A single OCR receipt is small (≤ 30 MiB input,
       a few hundred MiB scratch). We give the binary 1 GiB of memory and a
       short timeout to keep one upload from starving the rest of the box. -->
  <policy domain="resource" name="memory"      value="1GiB"/>
  <policy domain="resource" name="map"         value="2GiB"/>
  <policy domain="resource" name="disk"        value="4GiB"/>
  <policy domain="resource" name="area"        value="256MP"/>
  <policy domain="resource" name="width"       value="32KP"/>
  <policy domain="resource" name="height"      value="32KP"/>
  <policy domain="resource" name="time"        value="60"/>
  <policy domain="resource" name="thread"      value="2"/>
  <policy domain="resource" name="throttle"    value="0"/>
  <policy domain="resource" name="list-length" value="128"/>

  <!-- Disable risky / unneeded coders. Order matters: more general patterns
       last so the explicit names take effect. -->
  <policy domain="coder" rights="none" pattern="PDF" />
  <policy domain="coder" rights="none" pattern="EPS" />
  <policy domain="coder" rights="none" pattern="PS"  />
  <policy domain="coder" rights="none" pattern="PS2" />
  <policy domain="coder" rights="none" pattern="PS3" />
  <policy domain="coder" rights="none" pattern="XPS" />
  <policy domain="coder" rights="none" pattern="MSL" />
  <policy domain="coder" rights="none" pattern="MVG" />
  <policy domain="coder" rights="none" pattern="LABEL" />
  <policy domain="coder" rights="none" pattern="TEXT" />
  <policy domain="coder" rights="none" pattern="HTTPS" />
  <policy domain="coder" rights="none" pattern="HTTP" />
  <policy domain="coder" rights="none" pattern="URL" />
  <policy domain="coder" rights="none" pattern="FTP" />
  <policy domain="coder" rights="none" pattern="EPHEMERAL" />
  <policy domain="coder" rights="none" pattern="SHOW" />
  <policy domain="coder" rights="none" pattern="WIN" />
  <policy domain="coder" rights="none" pattern="X" />

  <!-- Path / delegate hardening. Block "magick @file" indirection
       (CVE-2016-3717-class) and indirect path attacks. -->
  <policy domain="path"     rights="none" pattern="@*" />
  <policy domain="delegate" rights="none" pattern="HTTPS"/>
  <policy domain="delegate" rights="none" pattern="HTTP"/>
  <policy domain="delegate" rights="none" pattern="URL"/>

</policymap>
